---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CourseHero from "../../../components/course/CourseHero.astro";
import CourseSidebar from "../../../components/course/CourseSidebar.astro";
import LessonContent from "../../../components/course/LessonContent.astro";
import htmlCourseCover from "../../../assets/images/html-course-cover.png";
import {
  getAllRealLessonParams,
  getRealLessonBySlug,
  htmlModules,
  HTML_MODULE_COUNT,
  FIRST_HTML_LESSON_PATH,
} from "../../../data/html-course";

export function getStaticPaths() {
  return getAllRealLessonParams().map((params) => ({ params }));
}

const { module: moduleSlug, lesson: lessonSlug } = Astro.params;
const found = getRealLessonBySlug(moduleSlug as string, lessonSlug as string);

if (!found) {
  return Astro.redirect("/html");
}

const { module: mod, lesson, prevLesson, nextLesson } = found;

const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Curso de HTML", url: "/html" },
  { name: lesson.title, url: Astro.url.pathname },
];
---

<BaseLayout
  title={`${lesson.title} — Curso de HTML — Código Real`}
  description={lesson.summary}
  breadcrumbs={breadcrumbs}
>
  <CourseHero
    icon="html5"
    title="Curso de HTML"
    subtitle="Construye la estructura de la web."
    description="Aprende cada etiqueta con ejemplos interactivos y crea proyectos reales."
    coverImage={htmlCourseCover}
  />

  <section class="bg-canvas">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[260px_1fr]">
        <CourseSidebar
          modules={htmlModules}
          moduleCount={HTML_MODULE_COUNT}
          basePath="/html"
          storageKey="codigo-real-html-progress"
          progressLabel="Progreso en HTML"
          ariaLabel="Módulos de HTML"
          activeModuleSlug={mod.slug}
          activeLessonSlug={lesson.slug}
        />
        <LessonContent
          module={mod}
          lesson={lesson}
          prevLesson={prevLesson}
          nextLesson={nextLesson}
          basePath="/html"
          courseLabel="HTML"
          firstLessonPath={FIRST_HTML_LESSON_PATH}
          storageKey="codigo-real-html-progress"
        />
      </div>
    </div>
  </section>
</BaseLayout>
