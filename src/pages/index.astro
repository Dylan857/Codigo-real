---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Playground from "../components/Playground.astro";
import LanguageGrid from "../components/LanguageGrid.astro";
import PopularTags from "../components/PopularTags.astro";
import CtaBanner from "../components/CtaBanner.astro";
---

<BaseLayout>
  <section id="inicio" class="border-b border-line bg-canvas">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:px-8 lg:py-24">
      <Hero />
      <div class="mt-12 lg:mt-16">
        <Playground />
      </div>
    </div>
  </section>

  <LanguageGrid />
  <PopularTags />
  <CtaBanner />
</BaseLayout>
