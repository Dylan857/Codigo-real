---
import Icon from "./Icon.astro";
---

<section class="bg-canvas py-4">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col items-start justify-between gap-6 rounded-2xl border border-line-soft bg-surface p-8 sm:flex-row sm:items-center sm:p-10"
    >
      <div class="flex items-start gap-4">
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-accent to-accent-2 text-white"
        >
          <Icon name="rocket" class="h-5.5 w-5.5" />
        </span>
        <div>
          <h2 class="text-xl font-bold text-ink sm:text-2xl">Construye algo increíble hoy</h2>
          <p class="mt-1.5 max-w-xl text-sm text-ink-muted sm:text-[15px]">
            La mejor forma de aprender es haciendo. Practica, experimenta y lleva tus ideas al
            siguiente nivel.
          </p>
        </div>
      </div>

      <a
        href="#playground"
        class="flex w-full shrink-0 items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-accent to-accent-2 px-6 py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.02] active:scale-[0.98] sm:w-auto"
      >
        Comenzar ahora
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
