---
interface Props {
  name:
    | "logo-mark"
    | "search"
    | "sun"
    | "moon"
    | "coffee"
    | "arrow-right"
    | "external-link"
    | "refresh"
    | "check"
    | "rocket"
    | "github"
    | "youtube"
    | "twitter"
    | "linkedin"
    | "heart"
    | "html5"
    | "css3"
    | "js"
    | "bolt"
    | "devices"
    | "chevron-right"
    | "chevron-down"
    | "book"
    | "lightbulb"
    | "alert-triangle"
    | "pencil"
    | "lock";
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

{
  name === "logo-mark" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M9 6 3.5 12 9 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M15 6 20.5 12 15 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "search" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6" />
      <path d="m20 20-3.8-3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "sun" && (
