---
import Icon from "./Icon.astro";

const tabs = [
  { id: "html", label: "HTML", icon: "html5", color: "text-html" },
  { id: "css", label: "CSS", icon: "css3", color: "text-css" },
  { id: "js", label: "JS", icon: "js", color: "text-js" },
] as const;
---

<div
  id="playground"
  class="overflow-hidden rounded-2xl border border-line bg-surface shadow-2xl shadow-black/30"
>
  <div class="flex items-center justify-between gap-3 border-b border-line bg-surface-2 px-3 py-2">
    <div class="flex items-center gap-1" role="tablist" aria-label="Lenguaje del editor">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            data-lang={tab.id}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls="editor-container"
            class="playground-tab flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium transition-colors data-[active=true]:bg-surface data-[active=true]:text-ink text-ink-muted hover:text-ink"
            data-active={i === 0 ? "true" : "false"}
          >
            <Icon name={tab.icon} class={`h-3.5 w-3.5 ${tab.color}`} />
            {tab.label}
          </button>
        ))
      }
    </div>
    <button
      type="button"
      id="playground-reset"
      class="flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium text-ink-muted transition-colors hover:text-ink"
    >
      <Icon name="refresh" class="h-3.5 w-3.5" />
      Reiniciar
    </button>
  </div>

  <div class="grid lg:grid-cols-2">
    <div class="relative border-b border-line lg:border-b-0 lg:border-r">
      <div id="editor-container" class="h-[320px] sm:h-[360px] lg:h-[420px]"></div>
      <div
        id="editor-loading"
        class="pointer-events-none absolute inset-0 flex items-center justify-center gap-2 bg-surface text-sm text-ink-muted"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent-2"></span>
        Cargando editor...
      </div>
    </div>

    <div class="flex flex-col bg-paper">
      <div class="flex items-center justify-between border-b border-paper-line px-4 py-2.5">
        <span class="text-xs font-semibold uppercase tracking-wide text-paper-ink-muted">Resultado:</span>
      </div>
      <div class="relative h-[280px] w-full flex-1 sm:h-[320px] lg:h-[370px]">
        <iframe id="preview-window" title="Resultado en vivo" class="h-full w-full bg-white" sandbox="allow-scripts"
        ></iframe>
        <div
          id="preview-loading"
          class="pointer-events-none absolute inset-0 flex items-center justify-center gap-2 bg-white text-sm text-paper-ink-muted"
        >
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
          Preparando resultado...
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-paper-line px-4 py-2.5">
        <label class="flex cursor-pointer items-center gap-2 text-xs font-medium text-paper-ink-muted">
          <span class="relative inline-flex h-5 w-9 shrink-0 items-center">
            <input
              type="checkbox"
              id="live-preview-toggle"
              name="live-preview"
              class="peer sr-only"
              checked
            />
            <span
              class="absolute inset-0 rounded-full bg-paper-line transition-colors peer-checked:bg-accent"
            ></span>
            <span
              class="absolute left-0.5 h-4 w-4 rounded-full bg-white shadow transition-transform peer-checked:translate-x-4"
            ></span>
          </span>
          Vista en tiempo real
        </label>
        <button
          type="button"
          id="playground-open"
          class="flex items-center gap-1.5 rounded-lg border border-paper-line px-3 py-1.5 text-xs font-semibold text-paper-ink transition-colors hover:bg-paper-muted"
        >
          Abrir en nueva pestaña
          <Icon name="external-link" class="h-3.5 w-3.5" />
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"
></script>

<script is:inline>
  (function () {
    var DEFAULTS = {
      html:
        '<!DOCTYPE html>\n<html lang="es">\n<head>\n  <meta charset="UTF-8">\n  <title>Mi primera página</title>\n</head>\n<body>\n  <h1>¡Hola mundo!</h1>\n  <p>Estoy aprendiendo desarrollo web en Código Real.</p>\n</body>\n</html>\n',
      css:
        "body {\n  font-family: system-ui, -apple-system, sans-serif;\n  color: #1e293b;\n  line-height: 1.6;\n}\n\nh1 {\n  margin-bottom: 0.5rem;\n}\n",
      js:
        "console.log('¡Bienvenido a Código Real!');\n\ndocument.querySelectorAll('h1').forEach((h1) => {\n  h1.addEventListener('click', () => {\n    h1.style.color = '#8b5cf6';\n  });\n});\n",
    };

    var models = {};
    var editor = null;
    var activeLang = "html";
    var livePreview = true;
    var updateTimer = null;

    var previewFrame = document.getElementById("preview-window");
    var previewLoadingEl = document.getElementById("preview-loading");
    var loadingEl = document.getElementById("editor-loading");
    var liveToggle = document.getElementById("live-preview-toggle");
    var resetBtn = document.getElementById("playground-reset");
    var openBtn = document.getElementById("playground-open");
    var tabButtons = Array.prototype.slice.call(document.querySelectorAll(".playground-tab"));

    function buildDocument() {
      var html = models.html ? models.html.getValue() : DEFAULTS.html;
      var css = models.css ? models.css.getValue() : DEFAULTS.css;
      var js = models.js ? models.js.getValue() : DEFAULTS.js;

      var styleTag = "\n<style>\n" + css + "\n</style>\n";
      var scriptTag = "\n<script>\n" + js + "\n<" + "/script>\n";

      var doc = html;
      doc = doc.indexOf("</head>") !== -1
        ? doc.replace("</head>", styleTag + "</head>")
        : styleTag + doc;
      doc = doc.indexOf("</body>") !== -1
        ? doc.replace("</body>", scriptTag + "</body>")
        : doc + scriptTag;

      return doc;
    }

    function renderPreview() {
      if (!previewFrame) return;
      previewFrame.srcdoc = buildDocument();
      if (previewLoadingEl) {
        previewLoadingEl.remove();
        previewLoadingEl = null;
      }
    }

    function scheduleRender() {
      if (!livePreview) return;
      window.clearTimeout(updateTimer);
      updateTimer = window.setTimeout(renderPreview, 250);
    }

    function setActiveTab(lang) {
      activeLang = lang;
      tabButtons.forEach(function (btn) {
        var isActive = btn.getAttribute("data-lang") === lang;
        btn.setAttribute("data-active", String(isActive));
        btn.setAttribute("aria-selected", String(isActive));
      });
      if (editor && models[lang]) {
        editor.setModel(models[lang]);
      }
    }

    tabButtons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        setActiveTab(btn.getAttribute("data-lang"));
      });
    });

    if (liveToggle) {
      liveToggle.addEventListener("change", function () {
        livePreview = liveToggle.checked;
        if (livePreview) renderPreview();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener("click", function () {
        Object.keys(DEFAULTS).forEach(function (lang) {
          if (models[lang]) models[lang].setValue(DEFAULTS[lang]);
        });
        renderPreview();
      });
    }

    if (openBtn) {
      openBtn.addEventListener("click", function () {
        var blob = new Blob([buildDocument()], { type: "text/html" });
        var url = URL.createObjectURL(blob);
        window.open(url, "_blank", "noopener");
        window.setTimeout(function () {
          URL.revokeObjectURL(url);
        }, 60000);
      });
    }

    window.addEventListener("codigo-real:theme-change", function (event) {
      if (window.monaco && editor) {
        var theme = event.detail && event.detail.theme === "light" ? "vs" : "vs-dark";
        window.monaco.editor.setTheme(theme);
      }
    });

    function bootMonaco() {
      if (!window.require) {
        if (loadingEl) loadingEl.textContent = "No se pudo cargar el editor.";
        if (previewLoadingEl) previewLoadingEl.textContent = "No se pudo cargar el resultado.";
        return;
      }

      window.require.config({
        paths: { vs: "https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs" },
      });

      window.require(["vs/editor/editor.main"], function () {
        var monaco = window.monaco;
        var currentTheme =
          document.documentElement.getAttribute("data-theme") === "light" ? "vs" : "vs-dark";

        models.html = monaco.editor.createModel(DEFAULTS.html, "html");
        models.css = monaco.editor.createModel(DEFAULTS.css, "css");
        models.js = monaco.editor.createModel(DEFAULTS.js, "javascript");

        editor = monaco.editor.create(document.getElementById("editor-container"), {
          model: models[activeLang],
          theme: currentTheme,
          automaticLayout: true,
          minimap: { enabled: false },
          fontSize: 14,
          lineHeight: 22,
          padding: { top: 16 },
          scrollBeyondLastLine: false,
          smoothScrolling: true,
        });

        Object.keys(models).forEach(function (lang) {
          models[lang].onDidChangeContent(scheduleRender);
        });

        if (loadingEl) loadingEl.remove();
        renderPreview();
      });
    }

    if (document.readyState === "complete") {
      bootMonaco();
    } else {
      window.addEventListener("load", bootMonaco);
    }
  })();
</script>
