---
import Icon from "./Icon.astro";
import { FIRST_HTML_LESSON_PATH } from "../data/html-course";

// TODO: once each tag has its own lesson, point `href` at that tag's specific module/lesson.
const tags = ["<h1>", "<p>", "<a>", "<img>", "<div>", "<span>", "<input>", "<button>", "<form>", "<table>", "<ul>", "<section>"].map(
  (label) => ({ label, href: FIRST_HTML_LESSON_PATH })
);
---

<section id="etiquetas" class="bg-paper pb-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-paper-ink sm:text-[1.75rem]">
          Explora por etiquetas populares
        </h2>
        <p class="mt-2 text-sm text-paper-ink-muted">
          Aprende con ejemplos prácticos de las etiquetas más usadas.
        </p>
      </div>
      <a
        href={FIRST_HTML_LESSON_PATH}
        class="flex shrink-0 items-center gap-1.5 text-sm font-semibold text-accent transition-colors hover:text-accent-2"
      >
        Ver todas las etiquetas
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-8 flex flex-wrap gap-2.5">
      {
        tags.map((tag) => (
          <a
            href={tag.href}
            class="rounded-full border border-paper-line px-4 py-2 font-mono text-sm text-paper-ink transition-colors hover:border-accent hover:text-accent"
          >
            {tag.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
