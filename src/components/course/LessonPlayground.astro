---
import Icon, { type IconName } from "../Icon.astro";

export interface LessonPlaygroundTab {
  id: "html" | "css" | "js";
  label: string;
  icon: IconName;
  color: string;
}

interface Props {
  id: string;
  tabs?: LessonPlaygroundTab[];
  defaultLang?: "html" | "css" | "js";
  initialCode: string | { html?: string; css?: string; js?: string };
}

const DEFAULT_TABS: LessonPlaygroundTab[] = [{ id: "html", label: "HTML", icon: "html5", color: "text-html" }];

const { id, tabs = DEFAULT_TABS, defaultLang, initialCode } = Astro.props;
const codeMap = typeof initialCode === "string" ? { html: initialCode } : initialCode;
const initialActiveId = tabs.some((t) => t.id === defaultLang) ? defaultLang : tabs[0]?.id;
---

<div
  id={id}
  data-tabs={JSON.stringify(tabs)}
  data-initial-code={JSON.stringify(codeMap)}
  class="lesson-playground overflow-hidden rounded-2xl border border-line bg-surface shadow-2xl shadow-black/30"
>
  <div class="flex items-center justify-between gap-3 border-b border-line bg-surface-2 px-3 py-2">
    <div class="flex items-center gap-1" role="tablist" aria-label="Lenguaje del editor">
      {
        tabs.map((tab) => (
          <button
            type="button"
            role="tab"
            data-lang={tab.id}
            aria-selected={tab.id === initialActiveId ? "true" : "false"}
            class="lesson-playground-tab flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium transition-colors data-[active=true]:bg-surface data-[active=true]:text-ink text-ink-muted hover:text-ink"
            data-active={tab.id === initialActiveId ? "true" : "false"}
          >
            <Icon name={tab.icon} class={`h-3.5 w-3.5 ${tab.color}`} />
            {tab.label}
          </button>
        ))
      }
    </div>
    <button
      type="button"
      class="lesson-playground-reset flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium text-ink-muted transition-colors hover:text-ink"
    >
      <Icon name="refresh" class="h-3.5 w-3.5" />
      Limpiar
    </button>
  </div>

  <div class="grid lg:grid-cols-2">
    <div class="relative border-b border-line lg:border-b-0 lg:border-r">
      <div class="lesson-editor-container h-[300px] sm:h-[340px]"></div>
      <div
        class="lesson-editor-loading pointer-events-none absolute inset-0 flex items-center justify-center gap-2 bg-surface text-sm text-ink-muted"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent-2"></span>
        Cargando editor...
      </div>
    </div>

    <div class="flex flex-col bg-paper">
      <div class="flex items-center justify-between border-b border-paper-line px-4 py-2.5">
        <span class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-paper-ink-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-html"></span>
          Resultado
        </span>
      </div>
      <div class="relative h-[260px] w-full flex-1 sm:h-[300px]">
        <iframe class="lesson-preview-window h-full w-full bg-white" title="Resultado en vivo" sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-forms allow-modals"
        ></iframe>
        <div
          class="lesson-preview-loading pointer-events-none absolute inset-0 flex items-center justify-center gap-2 bg-white text-sm text-paper-ink-muted"
        >
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
          Preparando resultado...
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"
></script>

<script>
  document.addEventListener("astro:page-load", function () {
    var roots = Array.prototype.slice.call(document.querySelectorAll(".lesson-playground"));
    var MONACO_LANGUAGE = { html: "html", css: "css", js: "javascript" };

    (window.__crLessonThemeListeners || []).forEach(function (fn) {
      window.removeEventListener("codigo-real:theme-change", fn);
    });
    window.__crLessonThemeListeners = [];

    (window.__crLessonPlaygroundInstances || []).forEach(function (instance) {
      Object.keys(instance.models).forEach(function (lang) {
        try {
          instance.models[lang].dispose();
        } catch (e) {}
      });
      try {
        instance.editor.dispose();
      } catch (e) {}
    });
    window.__crLessonPlaygroundInstances = [];

    roots.forEach(function (root) {
      var tabs = JSON.parse(root.getAttribute("data-tabs") || "[]");
      var codeMap = JSON.parse(root.getAttribute("data-initial-code") || "{}");
      var models = {};
      var editor = null;
      var initialActiveBtn = root.querySelector('.lesson-playground-tab[data-active="true"]');
      var activeLang = initialActiveBtn ? initialActiveBtn.getAttribute("data-lang") : tabs.length ? tabs[0].id : "html";
      var updateTimer = null;

      var editorContainer = root.querySelector(".lesson-editor-container");
      var loadingEl = root.querySelector(".lesson-editor-loading");
      var previewFrame = root.querySelector(".lesson-preview-window");
      var previewLoadingEl = root.querySelector(".lesson-preview-loading");
      var resetBtn = root.querySelector(".lesson-playground-reset");
      var tabButtons = Array.prototype.slice.call(root.querySelectorAll(".lesson-playground-tab"));

      function buildDocument() {
        var html = models.html ? models.html.getValue() : codeMap.html || "";
        var css = models.css ? models.css.getValue() : codeMap.css || "";
        var js = models.js ? models.js.getValue() : codeMap.js || "";

        var styleTag = "\n<style>\n" + css + "\n</style>\n";
        var scriptTag = "\n<script>\n" + js + "\n<" + "/script>\n";

        var doc = html;
        doc = doc.indexOf("</head>") !== -1 ? doc.replace("</head>", styleTag + "</head>") : styleTag + doc;
        doc = doc.indexOf("</body>") !== -1 ? doc.replace("</body>", scriptTag + "</body>") : doc + scriptTag;

        return doc;
      }

      function renderPreview() {
        if (!previewFrame) return;
        previewFrame.srcdoc = buildDocument();
        if (previewLoadingEl) {
          previewLoadingEl.remove();
          previewLoadingEl = null;
        }
      }

      function scheduleRender() {
        window.clearTimeout(updateTimer);
        updateTimer = window.setTimeout(renderPreview, 250);
      }

      function setActiveTab(lang) {
        activeLang = lang;
        tabButtons.forEach(function (btn) {
          var isActive = btn.getAttribute("data-lang") === lang;
          btn.setAttribute("data-active", String(isActive));
          btn.setAttribute("aria-selected", String(isActive));
        });
        if (editor && models[lang]) {
          editor.setModel(models[lang]);
        }
      }

      tabButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
          setActiveTab(btn.getAttribute("data-lang"));
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener("click", function () {
          Object.keys(codeMap).forEach(function (lang) {
            if (models[lang]) models[lang].setValue(codeMap[lang]);
          });
          renderPreview();
        });
      }

      root.addEventListener("codigo-real:load-challenge", function (event) {
        var code = event.detail && event.detail.code;
        if (!code) return;
        var map = typeof code === "string" ? { html: code } : code;
        Object.keys(map).forEach(function (lang) {
          if (models[lang]) models[lang].setValue(map[lang]);
        });
        renderPreview();
      });

      function handleThemeChange(event) {
        if (window.monaco && editor) {
          var theme = event.detail && event.detail.theme === "light" ? "vs" : "vs-dark";
          window.monaco.editor.setTheme(theme);
        }
      }
      window.__crLessonThemeListeners.push(handleThemeChange);
      window.addEventListener("codigo-real:theme-change", handleThemeChange);

      function bootMonaco() {
        if (!window.require || !editorContainer) {
          if (loadingEl) loadingEl.textContent = "No se pudo cargar el editor.";
          return;
        }

        window.require.config({
          paths: { vs: "https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs" },
        });

        window.require(["vs/editor/editor.main"], function () {
          var monaco = window.monaco;
          var currentTheme = document.documentElement.getAttribute("data-theme") === "light" ? "vs" : "vs-dark";

          tabs.forEach(function (tab) {
            models[tab.id] = monaco.editor.createModel(codeMap[tab.id] || "", MONACO_LANGUAGE[tab.id]);
          });

          editor = monaco.editor.create(editorContainer, {
            model: models[activeLang],
            theme: currentTheme,
            automaticLayout: true,
            minimap: { enabled: false },
            fontSize: 14,
            lineHeight: 22,
            padding: { top: 16 },
            scrollBeyondLastLine: false,
            smoothScrolling: true,
          });

          Object.keys(models).forEach(function (lang) {
            models[lang].onDidChangeContent(scheduleRender);
          });

          window.__crLessonPlaygroundInstances.push({ editor: editor, models: models });

          if (loadingEl) loadingEl.remove();
          renderPreview();
        });
      }

      bootMonaco();
    });
  });
</script>
