---
import Icon, { type IconName } from "../Icon.astro";

interface Props {
  icon: IconName;
  title: string;
  subtitle: string;
  description: string;
  coverImage?: string;
}

const { icon, title, subtitle, description, coverImage } = Astro.props;
---

<section class="border-b border-line bg-canvas">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
    <div class="flex items-center gap-5">
      <Icon name={icon} class="h-16 w-16 shrink-0" />
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">{title}</h1>
        <p class="mt-1 text-[15px] font-medium text-ink-muted">{subtitle}</p>
        <p class="mt-1 max-w-md text-sm text-ink-muted">{description}</p>
      </div>
    </div>

    {
      coverImage && (
        <div class="relative hidden overflow-hidden rounded-2xl lg:block lg:h-56 lg:w-[440px] xl:w-[520px]">
          <img src={coverImage} alt="" class="h-full w-full object-cover object-[65%_center]" />
          <div class="absolute inset-0 bg-gradient-to-r from-canvas to-transparent" />
        </div>
      )
    }
  </div>
</section>
