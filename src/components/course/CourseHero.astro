---
import Icon from "../Icon.astro";
---

<section class="border-b border-line bg-canvas">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
    <div class="flex items-center gap-5">
      <Icon name="html5" class="h-16 w-16 shrink-0" />
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Curso de HTML</h1>
        <p class="mt-1 text-[15px] font-medium text-ink-muted">Construye la estructura de la web.</p>
        <p class="mt-1 max-w-md text-sm text-ink-muted">
          Aprende cada etiqueta con ejemplos interactivos y crea proyectos reales.
        </p>
      </div>
    </div>

    <div class="relative hidden overflow-hidden rounded-2xl lg:block lg:h-56 lg:w-[440px] xl:w-[520px]">
      <img src="/images/html-course-cover.png" alt="" class="h-full w-full object-cover object-[65%_center]" />
      <div class="absolute inset-0 bg-gradient-to-r from-canvas to-transparent"></div>
    </div>
  </div>
</section>
