---
import Icon from "../Icon.astro";
import type { AdjacentLesson, RealLesson } from "../../data/course-types";

interface Props {
  lesson: RealLesson;
  nextLesson: AdjacentLesson | null;
  basePath: string;
}

const { lesson, nextLesson, basePath } = Astro.props;

const inThisLesson = [
  "Ejemplo interactivo",
  "Explicación de cada etiqueta",
  "Cuándo usarlo",
  "Errores comunes",
];
---

<div class="flex flex-col gap-4">
  <div class="rounded-2xl border border-line bg-surface p-5">
    <p class="text-sm font-semibold text-ink">En esta lección</p>
    <ul class="mt-3 space-y-2">
      {
        inThisLesson.map((item) => (
          <li class="flex items-start gap-2 text-sm text-ink-muted">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="rounded-2xl border border-sky-200 bg-sky-50 p-5 dark:border-sky-500/30 dark:bg-sky-500/10">
    <div class="flex items-center gap-2">
      <Icon name="lightbulb" class="h-4.5 w-4.5 text-sky-600 dark:text-sky-400" />
      <p class="text-sm font-semibold text-sky-900 dark:text-sky-200">Consejo</p>
    </div>
    <p class="mt-2 text-sm text-sky-900/80 dark:text-sky-200/80">{lesson.tip}</p>
  </div>

  <div class="rounded-2xl border border-accent/25 bg-accent-ink p-5 dark:border-accent/40 dark:bg-accent/10">
    <div class="flex items-center gap-2">
      <Icon name="rocket" class="h-4.5 w-4.5 text-accent" />
      <p class="text-sm font-semibold text-ink">Dato extra</p>
    </div>
    <p class="mt-2 text-sm text-ink/80">{lesson.extra}</p>
  </div>

  <div class="rounded-2xl border border-red-200 bg-red-50 p-5 dark:border-red-500/30 dark:bg-red-500/10">
    <div class="flex items-center gap-2">
      <Icon name="alert-triangle" class="h-4.5 w-4.5 text-red-600 dark:text-red-400" />
      <p class="text-sm font-semibold text-red-900 dark:text-red-200">Error común</p>
    </div>
    <p class="mt-2 text-sm text-red-900/80 dark:text-red-200/80">{lesson.commonError}</p>
  </div>

  <div class="rounded-2xl border border-accent/25 bg-accent-ink p-5 dark:border-accent/40 dark:bg-accent/10">
    <div class="flex items-center gap-2">
      <Icon name="arrow-right" class="h-4.5 w-4.5 text-accent" />
      <p class="text-sm font-semibold text-ink">Siguiente paso</p>
    </div>
    <p class="mt-2 text-sm text-ink/80">{lesson.nextStepText}</p>
    {
      nextLesson ? (
        <a
          href={`${basePath}/${nextLesson.moduleSlug}/${nextLesson.slug}`}
          class="mt-4 flex items-center justify-center gap-1.5 rounded-lg bg-gradient-to-r from-accent to-accent-2 px-4 py-2 text-xs font-semibold text-white transition-transform hover:scale-[1.02] active:scale-[0.98]"
        >
          Ir a la siguiente lección
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      ) : (
        <span class="mt-4 flex items-center justify-center gap-1.5 rounded-lg border border-line px-4 py-2 text-xs font-semibold text-ink-muted">
          <Icon name="lock" class="h-3.5 w-3.5" />
          Próximo módulo (pronto)
        </span>
      )
    }
  </div>
</div>
