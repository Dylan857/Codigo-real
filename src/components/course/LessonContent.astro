---
import Icon from "../Icon.astro";
import LessonPlayground from "./LessonPlayground.astro";
import LessonAside from "./LessonAside.astro";
import { FIRST_HTML_LESSON_PATH, type AdjacentLesson, type CourseModule, type RealLesson } from "../../data/html-course";

interface Props {
  module: CourseModule;
  lesson: RealLesson;
  prevLesson: AdjacentLesson | null;
  nextLesson: AdjacentLesson | null;
}

const { module: mod, lesson, prevLesson, nextLesson } = Astro.props;
const playgroundId = `playground-${lesson.slug}`;
---

<div>
  <nav class="flex flex-wrap items-center gap-1.5 text-sm text-ink-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-ink">Inicio</a>
    <Icon name="chevron-right" class="h-3.5 w-3.5" />
    <a href={FIRST_HTML_LESSON_PATH} class="hover:text-ink">HTML</a>
    <Icon name="chevron-right" class="h-3.5 w-3.5" />
    <span>{mod.title}</span>
    <Icon name="chevron-right" class="h-3.5 w-3.5" />
    <span class="text-ink">{lesson.title}</span>
  </nav>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">{lesson.title}</h1>
    <div class="flex items-center gap-2">
      {
        prevLesson ? (
          <a
            href={`/html/${prevLesson.moduleSlug}/${prevLesson.slug}`}
            class="flex items-center gap-1.5 rounded-lg border border-line px-3.5 py-2 text-sm font-semibold text-ink transition-colors hover:bg-surface"
          >
            <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
            Anterior
          </a>
        ) : (
          <span class="flex items-center gap-1.5 rounded-lg border border-line px-3.5 py-2 text-sm font-semibold text-ink-muted/50">
            <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
            Anterior
          </span>
        )
      }
      {
        nextLesson ? (
          <a
            href={`/html/${nextLesson.moduleSlug}/${nextLesson.slug}`}
            class="flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-accent to-accent-2 px-3.5 py-2 text-sm font-semibold text-white transition-transform hover:scale-[1.02] active:scale-[0.98]"
          >
            Siguiente
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        ) : (
          <span class="flex items-center gap-1.5 rounded-lg bg-surface-2 px-3.5 py-2 text-sm font-semibold text-ink-muted/60">
            Siguiente
            <Icon name="arrow-right" class="h-4 w-4" />
          </span>
        )
      }
    </div>
  </div>

  <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-ink-muted">{lesson.summary}</p>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_300px]">
    <div class="flex flex-col gap-6">
      <LessonPlayground id={playgroundId} initialCode={lesson.playgroundCode} />

      <div class="flex items-start gap-2.5 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900 dark:border-sky-500/30 dark:bg-sky-500/10 dark:text-sky-200">
        <Icon name="lightbulb" class="mt-0.5 h-4 w-4 shrink-0 text-sky-600 dark:text-sky-400" />
        {lesson.hint}
      </div>

      <div>
        <div class="flex items-center gap-2">
          <Icon name="book" class="h-5 w-5 text-ink" />
          <h2 class="text-xl font-bold text-ink">Explicación</h2>
        </div>
        <p class="mt-2 text-sm text-ink-muted">{lesson.explanationIntro}</p>

        <div class="mt-4 overflow-hidden rounded-xl border border-line">
          {
            lesson.explanationRows.map((row, i) => (
              <div
                class={`grid grid-cols-1 gap-1.5 px-4 py-3 sm:grid-cols-[minmax(160px,240px)_1fr] sm:gap-4 ${
                  i % 2 === 1 ? "bg-surface-2" : "bg-surface"
                }`}
              >
                <code class="text-[13px] font-medium text-accent">{row.code}</code>
                <p class="text-sm text-ink-muted">{row.desc}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-4 rounded-xl border border-emerald-200 bg-emerald-50 p-5 sm:flex-row sm:items-center sm:justify-between dark:border-emerald-500/30 dark:bg-emerald-500/10">
        <div class="flex items-start gap-2.5">
          <Icon name="pencil" class="mt-0.5 h-5 w-5 shrink-0 text-emerald-700 dark:text-emerald-400" />
          <div>
            <p class="text-sm font-semibold text-emerald-900 dark:text-emerald-200">Reto rápido</p>
            <p class="mt-1 text-sm text-emerald-900/80 dark:text-emerald-200/80">{lesson.challenge.description}</p>
          </div>
        </div>
        <button
          type="button"
          class="lesson-challenge-btn flex shrink-0 items-center justify-center gap-1.5 rounded-lg border border-emerald-300 bg-white px-4 py-2 text-sm font-semibold text-emerald-800 transition-colors hover:bg-emerald-100 dark:border-emerald-500/40 dark:bg-surface dark:text-emerald-200 dark:hover:bg-surface-2"
          data-target={playgroundId}
          data-challenge-code={lesson.challenge.code}
        >
          ¡Acepto el reto!
          <Icon name="arrow-right" class="h-4 w-4" />
        </button>
      </div>
    </div>

    <LessonAside lesson={lesson} nextLesson={nextLesson} />
  </div>
</div>

<script define:vars={{ moduleSlug: mod.slug, lessonSlug: lesson.slug }}>
  (function () {
    var STORAGE_KEY = "codigo-real-html-progress";
    var key = moduleSlug + "/" + lessonSlug;
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      var completed = raw ? JSON.parse(raw) : [];
      if (completed.indexOf(key) === -1) {
        completed.push(key);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(completed));
      }
    } catch (e) {}
    window.dispatchEvent(new CustomEvent("codigo-real:progress-updated"));
  })();
</script>

<script>
  document.addEventListener("astro:page-load", function () {
    var buttons = Array.prototype.slice.call(document.querySelectorAll(".lesson-challenge-btn"));
    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var targetId = btn.getAttribute("data-target");
        var code = btn.getAttribute("data-challenge-code") || "";
        var root = targetId ? document.getElementById(targetId) : null;
        if (root) {
          root.dispatchEvent(new CustomEvent("codigo-real:load-challenge", { detail: { code: code } }));
          root.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });
    });
  });
</script>
