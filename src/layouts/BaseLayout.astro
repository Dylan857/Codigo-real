---
import { ClientRouter } from "astro:transitions";
import Icon from "../components/Icon.astro";
import { FIRST_HTML_LESSON_PATH } from "../data/html-course";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Código Real — Aprende desarrollo web practicando",
  description = "Explora HTML, CSS y JavaScript de forma interactiva. Escribe código real, ve los resultados al instante y crea proyectos reales desde el primer día. 100% gratis, sin registro.",
} = Astro.props;

const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "HTML", href: FIRST_HTML_LESSON_PATH, activeMatch: "/html" },
  { label: "CSS", href: "/#css" },
  { label: "JavaScript", href: "/#javascript" },
  { label: "Ejercicios", href: "/#ejercicios" },
  { label: "Blog", href: "/#blog" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isNavLinkActive(link: { href: string; activeMatch?: string }) {
  const path = (link.activeMatch ?? link.href).split("#")[0] || "/";
  if (path === "/") {
    return currentPath === "/";
  }
  return currentPath === path || currentPath.startsWith(`${path}/`);
}

const footerColumns = [
  {
    title: "Aprende",
    links: ["HTML", "CSS", "JavaScript", "Ejercicios"],
  },
  {
    title: "Recursos",
    links: ["Blog", "Proyectos", "Herramientas", "Preguntas frecuentes"],
  },
  {
    title: "Apóyame",
    links: ["Donaciones", "Afiliados", "Anúnciate aquí", "Contacta"],
  },
];

const year = new Date().getFullYear();
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        function readTheme() {
          try {
            var stored = localStorage.getItem("codigo-real-theme");
            return stored === "light" ? "light" : "dark";
          } catch (e) {
            return "dark";
          }
        }
        document.documentElement.setAttribute("data-theme", readTheme());
        document.addEventListener("astro:before-preparation", function () {
          var bar = document.getElementById("route-progress");
          if (bar) bar.classList.add("is-active");
        });
        document.addEventListener("astro:before-swap", function (event) {
          event.newDocument.documentElement.setAttribute("data-theme", readTheme());

          var monacoColors = document.head.querySelector("style.monaco-colors");
          if (monacoColors) {
            window.__crMonacoColorsCSS = monacoColors.textContent;
          }
          var monacoCssLink = document.head.querySelector('link[rel="stylesheet"][href*="monaco-editor"]');
          if (monacoCssLink) {
            window.__crMonacoCssHref = monacoCssLink.getAttribute("href");
          }
        });
        document.addEventListener("astro:page-load", function () {
          var bar = document.getElementById("route-progress");
          if (bar) bar.classList.remove("is-active");

          if (window.__crMonacoColorsCSS && !document.head.querySelector("style.monaco-colors")) {
            var style = document.createElement("style");
            style.className = "monaco-colors";
            style.textContent = window.__crMonacoColorsCSS;
            document.head.appendChild(style);
          }
          if (
            window.__crMonacoCssHref &&
            !document.head.querySelector('link[rel="stylesheet"][href*="monaco-editor"]')
          ) {
            var link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = window.__crMonacoCssHref;
            document.head.appendChild(link);
          }
        });
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="bg-canvas text-ink">
    <div id="route-progress" class="pointer-events-none fixed left-0 top-0 z-[60] h-[3px] w-2/5 bg-accent-2 opacity-0" aria-hidden="true"></div>

    <header
      transition:name="site-header"
      class="sticky top-0 z-50 border-b border-line bg-canvas/90 backdrop-blur supports-[backdrop-filter]:bg-canvas/75"
    >
      <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
        <a href="#inicio" class="flex items-center gap-2 shrink-0">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-accent to-accent-2 text-white"
          >
            <Icon name="logo-mark" class="h-4.5 w-4.5" />
          </span>
          <span class="text-[15px] font-bold tracking-tight text-ink">Código Real</span>
          <span
            class="rounded-full border border-line-soft px-2 py-0.5 text-[11px] font-medium text-ink-muted"
            >Beta</span
          >
        </a>

        <nav class="hidden items-center gap-6 pl-2 lg:flex">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                aria-current={isNavLinkActive(link) ? "page" : undefined}
                class={`text-sm font-medium transition-colors ${
                  isNavLinkActive(link) ? "text-ink" : "text-ink-muted hover:text-ink"
                }`}
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <div class="ml-auto flex items-center gap-2.5">
          <label class="relative hidden sm:block">
            <span class="sr-only">Buscar etiquetas o ejemplos</span>
            <Icon
              name="search"
              class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-muted"
            />
            <input
              type="search"
              id="nav-search"
              name="q"
              placeholder="Buscar etiquetas, ejemplos..."
              class="w-48 rounded-lg border border-line bg-surface py-2 pl-9 pr-3 text-sm text-ink placeholder:text-ink-muted focus:w-64 focus:border-accent-2 focus:outline-none transition-[width,border-color] md:w-64"
            />
          </label>

          <button
            type="button"
            id="theme-toggle"
            aria-label="Cambiar tema"
            aria-pressed="false"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-line text-ink-muted transition-colors hover:text-ink"
          >
            <Icon name="sun" class="theme-icon-sun h-4.5 w-4.5" />
            <Icon name="moon" class="theme-icon-moon h-4.5 w-4.5" />
          </button>

          <a
            href="#"
            class="flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-accent to-accent-2 px-4 py-2 text-sm font-semibold text-white shadow-[0_1px_0_0_rgba(255,255,255,0.15)_inset] transition-transform hover:scale-[1.03] active:scale-[0.98]"
          >
            Apóyame
            <Icon name="coffee" class="h-4 w-4" />
          </a>

          <button
            type="button"
            id="mobile-menu-toggle"
            aria-label="Abrir menú de navegación"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-line text-ink-muted transition-colors hover:text-ink lg:hidden"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-4.5 w-4.5" aria-hidden="true">
              <path
                d="M4 6.5h16M4 12h16M4 17.5h16"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              ></path>
            </svg>
          </button>
        </div>
      </div>

      <nav
        id="mobile-menu"
        class="hidden border-t border-line px-4 pb-5 pt-3 lg:hidden"
        aria-label="Navegación principal"
      >
        <label class="relative block sm:hidden">
          <span class="sr-only">Buscar etiquetas o ejemplos</span>
          <Icon
            name="search"
            class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-muted"
          />
          <input
            type="search"
            id="nav-search-mobile"
            name="q"
            placeholder="Buscar etiquetas, ejemplos..."
            class="w-full rounded-lg border border-line bg-surface py-2 pl-9 pr-3 text-sm text-ink placeholder:text-ink-muted focus:border-accent-2 focus:outline-none"
          />
        </label>
        <ul class="mt-3 flex flex-col divide-y divide-line sm:mt-0">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isNavLinkActive(link) ? "page" : undefined}
                  class={`block py-3 text-[15px] font-medium ${
                    isNavLinkActive(link) ? "text-ink" : "text-ink-muted"
                  }`}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-line bg-canvas">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-10 sm:grid-cols-2 lg:grid-cols-5">
          <div class="col-span-2">
            <a href="#inicio" class="flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-accent to-accent-2 text-white"
              >
                <Icon name="logo-mark" class="h-4.5 w-4.5" />
              </span>
              <span class="text-[15px] font-bold tracking-tight text-ink">Código Real</span>
            </a>
            <p class="mt-3 max-w-xs text-sm text-ink-muted">Aprende. Practica. Construye.</p>
            <div class="mt-5 flex items-center gap-3 text-ink-muted">
              <a href="#" aria-label="YouTube" class="transition-colors hover:text-ink"
                ><Icon name="youtube" class="h-5 w-5" /></a
              >
              <a href="#" aria-label="GitHub" class="transition-colors hover:text-ink"
                ><Icon name="github" class="h-5 w-5" /></a
              >
              <a href="#" aria-label="Twitter" class="transition-colors hover:text-ink"
                ><Icon name="twitter" class="h-5 w-5" /></a
              >
              <a href="#" aria-label="LinkedIn" class="transition-colors hover:text-ink"
                ><Icon name="linkedin" class="h-5 w-5" /></a
              >
            </div>
          </div>

          {
            footerColumns.map((col) => (
              <div>
                <h3 class="text-sm font-semibold text-ink">{col.title}</h3>
                <ul class="mt-4 space-y-3">
                  {col.links.map((link) => (
                    <li>
                      <a href="#" class="text-sm text-ink-muted transition-colors hover:text-ink">
                        {link}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }

          <div class="hidden lg:block">
            <p class="text-sm italic text-ink-muted">"El código también puede cambiar vidas."</p>
          </div>
        </div>

        <div
          class="mt-14 flex flex-col-reverse items-center justify-between gap-4 border-t border-line pt-8 sm:flex-row"
        >
          <p class="flex items-center gap-1.5 text-sm text-ink-muted">
            © {year} Código Real. Hecho con <Icon name="heart" class="h-3.5 w-3.5 text-accent-2" /> para
            la comunidad.
          </p>
          <div class="flex items-center gap-6">
            <a href="#" class="text-sm text-ink-muted transition-colors hover:text-ink">Términos</a>
            <a href="#" class="text-sm text-ink-muted transition-colors hover:text-ink">Privacidad</a>
            <a href="#" class="text-sm text-ink-muted transition-colors hover:text-ink">Contacto</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener("astro:page-load", function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var root = document.documentElement;
          var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
          root.setAttribute("data-theme", next);
          btn.setAttribute("aria-pressed", String(next === "light"));
          try {
            localStorage.setItem("codigo-real-theme", next);
          } catch (e) {}
          window.dispatchEvent(new CustomEvent("codigo-real:theme-change", { detail: { theme: next } }));
        });
      });
    </script>

    <script is:inline>
      document.addEventListener("astro:page-load", function () {
        var toggle = document.getElementById("mobile-menu-toggle");
        var menu = document.getElementById("mobile-menu");
        if (!toggle || !menu) return;
        toggle.addEventListener("click", function () {
          var isOpen = !menu.classList.contains("hidden");
          menu.classList.toggle("hidden");
          toggle.setAttribute("aria-expanded", String(!isOpen));
        });
        menu.querySelectorAll("a").forEach(function (link) {
          link.addEventListener("click", function () {
            menu.classList.add("hidden");
            toggle.setAttribute("aria-expanded", "false");
          });
        });
      });
    </script>

    <slot name="scripts" />

    <style>
      #route-progress.is-active {
        opacity: 1;
        animation: route-progress-sweep 900ms ease-in-out infinite;
      }
      @keyframes route-progress-sweep {
        0% {
          transform: translateX(-100%);
        }
        100% {
          transform: translateX(350%);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #route-progress.is-active {
          animation: none;
          opacity: 0.6;
          width: 100%;
          transform: none;
        }
      }
    </style>
  </body>
</html>
